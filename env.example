# Copy the relevant blocks into real .env files (kiro.env, elevenlabs.env,
# composio.env) and fill in your own keys. The real .env files are gitignored.

# ---- kiro.env ----
LLM_BACKEND=kiro_cli
KIRO_API_KEY=your_ksk_key_here
KIRO_MODEL=claude-sonnet-4-5

# ---- elevenlabs.env ----
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
ELEVENLABS_MODEL=eleven_multilingual_v2

# ---- composio.env ----
apikey=your_composio_key_here
